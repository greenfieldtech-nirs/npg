# --- Backend (Maven) ---
backend/target/
backend/dependency-reduced-pom.xml

# --- Frontend (Node / Vite) ---
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
npm-debug.log*

# --- Environment / secrets ---
# Only the dev defaults and the production template are tracked.
.env
.env.*
docker/.env.*
!docker/.env.dev
!docker/.env.production.example

# TLS material is supplied per deployment (see docker/tls/README.md)
docker/tls/*
!docker/tls/README.md
*.pem
*.key
*.crt
*.p12
*.jks

# --- Operational output ---
backups/
docker/backups/
*.log

# --- IDE / OS ---
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# --- Local AI-assistant state ---
.claude/settings.local.json
