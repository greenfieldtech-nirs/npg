# Production configuration for ./npg -e production.
# Copy to docker/.env.production (git-ignored) and replace every value marked REQUIRED.

# --- secrets (REQUIRED) -------------------------------------------------------
DB_PASSWORD=REQUIRED-change-me
DB_ROOT_PASSWORD=REQUIRED-change-me
MONGO_PASSWORD=REQUIRED-change-me
# at least 32 random characters, e.g. `openssl rand -base64 48`
NPG_JWT_SECRET=REQUIRED-change-me
# first admin login; at least 12 characters (only used when the admin account does not exist yet)
NPG_ADMIN_USERNAME=admin
NPG_ADMIN_PASSWORD=REQUIRED-change-me

# --- datastores ----------------------------------------------------------------
DB_NAME=npg
DB_USER=npg
DB_POOL_MAX_SIZE=10
MONGO_USER=npg
MONGO_DB=npg

# --- edge and peers --------------------------------------------------------------
# The load balancer terminates TLS and connects to NGINX on port 8090 (plain HTTP).
APP_PUBLIC_BASE_URL=https://npg.example.co.il
# interface NGINX's port 8090 is published on; restrict it to the one the load balancer reaches
NPG_HTTP_BIND=0.0.0.0
# proxies whose X-Real-IP header the backend believes ("private" = Docker networks, i.e. NGINX)
TRUSTED_PROXIES=private
# strict: only configured, active peers presenting their credential (IP allowlist behind the LB)
INBOUND_AUTH_MODE=strict
# keep false: TLS ends at the load balancer, so NGINX cannot verify peer client certificates
INBOUND_TRUST_PROXY_CLIENT_CERT=false

# --- porting policy ----------------------------------------------------------------
# MANUAL: the NOC approves each port-out; AUTO_APPROVE: approve when the hard rules pass
PORT_OUT_DECISION_MODE=MANUAL
PORTING_KD_UPDATE_REQUIRED=false
PORTING_DEFAULT_LEAD_MINUTES=15

# --- outbound mTLS (optional; files under docker/tls/, mounted at /app/tls) ------------
OUTBOUND_TLS_KEYSTORE=
OUTBOUND_TLS_KEYSTORE_PASSWORD=
OUTBOUND_TLS_TRUSTSTORE=
OUTBOUND_TLS_TRUSTSTORE_PASSWORD=

LOG_LEVEL=INFO
