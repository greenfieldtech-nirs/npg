#!/usr/bin/env bash
# NPG stack launcher — single entry point for the Docker Compose stacks.
#
# Usage:
#   ./npg [options] <action>
#
# Actions:
#   start        Start the container stack, detached (builds images first)
#   foreground   Start the container stack in the foreground (Ctrl-C stops)
#   stop         Stop the container stack completely
#   rm           Stop the stack and remove the images built by it
#
# Options:
#   -e, --environment <dev|production>   Target environment (default: production)
#   -c, --config <file>                  Environment file (default: docker/.env.<environment>)
#   -h, --help                           Show this help
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

ENVIRONMENT="production"
CONFIG=""
ACTION=""

usage() {
    sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -e|--environment)
            ENVIRONMENT="${2:?Missing value for $1}"
            shift 2
            ;;
        --environment=*)
            ENVIRONMENT="${1#*=}"
            shift
            ;;
        -c|--config)
            CONFIG="${2:?Missing value for $1}"
            shift 2
            ;;
        --config=*)
            CONFIG="${1#*=}"
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        start|foreground|stop|rm)
            ACTION="$1"
            shift
            ;;
        *)
            echo "Unknown argument: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
done

if [[ -z "$ACTION" ]]; then
    echo "Missing action." >&2
    usage >&2
    exit 1
fi

case "$ENVIRONMENT" in
    dev|development)
        ENVIRONMENT="dev"
        COMPOSE_FILE="docker/docker-compose.dev.yml"
        ;;
    production|prod)
        ENVIRONMENT="production"
        COMPOSE_FILE="docker/docker-compose.prod.yml"
        ;;
    *)
        echo "Invalid environment: $ENVIRONMENT (expected dev or production)" >&2
        exit 1
        ;;
esac

if [[ -z "$CONFIG" ]]; then
    DEFAULT_CONFIG="docker/.env.${ENVIRONMENT}"
    if [[ -f "$DEFAULT_CONFIG" ]]; then
        CONFIG="$DEFAULT_CONFIG"
    fi
fi

if [[ "$ENVIRONMENT" == "production" && -z "$CONFIG" && "$ACTION" != "stop" && "$ACTION" != "rm" ]]; then
    echo "No production config found at docker/.env.production." >&2
    echo "Copy docker/.env.production.example to docker/.env.production and fill in real values." >&2
    exit 1
fi

COMPOSE=(docker compose -f "$COMPOSE_FILE")
if [[ -n "$CONFIG" ]]; then
    if [[ ! -f "$CONFIG" ]]; then
        echo "Config file not found: $CONFIG" >&2
        exit 1
    fi
    COMPOSE+=(--env-file "$CONFIG")
fi

echo "Environment: $ENVIRONMENT ($COMPOSE_FILE)${CONFIG:+ config=$CONFIG}"

case "$ACTION" in
    start)
        "${COMPOSE[@]}" up --build -d
        ;;
    foreground)
        "${COMPOSE[@]}" up --build
        ;;
    stop)
        "${COMPOSE[@]}" down
        ;;
    rm)
        "${COMPOSE[@]}" down --rmi local
        ;;
esac
